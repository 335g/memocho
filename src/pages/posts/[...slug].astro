---
import { type CollectionEntry, getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((post) => import.meta.env.DEV || !post.data.draft)
    .map((post) => ({
      // post.id から拡張子(.md)を除去してスラッグ化
      params: { slug: post.id.replace(/\.md$/, "") },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { data } = post;

const pubDateFormatted = data.pubDate.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const updatedDateFormatted = data.updatedDate
  ? data.updatedDate.toLocaleDateString("ja-JP", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const description = data.description.slice(0, 160);

// スラッグ
const slug = post.id.replace(/\.md$/, "");
const postUrl = new URL(`/posts/${slug}`, SITE.url).href;

// X (Twitter) 共有用 URL
const tweetText = `${data.title} ${postUrl} @335g`;
const tweetUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(tweetText)}`;

// 構造化データ: BlogPosting
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: data.updatedDate
    ? data.updatedDate.toISOString()
    : data.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: SITE.author.name,
  },
  url: postUrl,
};
---

<Base
  title={data.title}
  description={description}
  path={`/posts/${post.id.replace(/\.md$/, "")}`}
  ogImage={data.ogImage ?? `/og/${slug}.png`}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-8 sm:py-12">
    <!-- メタ情報ヘッダー -->
    <header class="mb-10">
      <!-- タイトル -->
      <h1
        class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
        data-pagefind-meta="title"
      >
        {data.title}
      </h1>

      <!-- 説明 -->
      <p class="mt-3 text-lg text-muted-foreground">
        {data.description}
      </p>

      <!-- 日付とタグ -->
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-border pb-6">
        <!-- 公開日 -->
        <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
            <line x1="16" x2="16" y1="2" y2="6" />
            <line x1="8" x2="8" y1="2" y2="6" />
            <line x1="3" x2="21" y1="10" y2="10" />
          </svg>
          <time datetime={data.pubDate.toISOString()} data-pagefind-meta="date">
            {pubDateFormatted}
          </time>
        </div>

        <!-- 更新日（ある場合のみ） -->
        {
          data.updatedDate && updatedDateFormatted && (
            <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
              </svg>
              <span>更新: </span>
              <time datetime={data.updatedDate.toISOString()}>
                {updatedDateFormatted}
              </time>
            </div>
          )
        }

        <!-- タグ一覧 -->
        {
          data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5" aria-label="タグ" data-pagefind-meta="tags">
              {
                data.tags.map((tag) => (
                  <li>
                    <a
                      href={`/tags/${tag}`}
                      class="inline-block rounded-full bg-muted px-2.5 py-0.5 text-xs font-medium text-muted-foreground no-underline transition-colors hover:bg-primary/10 hover:text-primary"
                    >
                      #{tag}
                    </a>
                  </li>
                ))
              }
            </ul>
          )
        }

        <!-- Xでポスト -->
        <a
          href={tweetUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-auto inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-sm font-medium text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          Xでポスト
        </a>
      </div>
    </header>

    <!-- 記事本文 -->
    <div class="prose" data-pagefind-body>
      <Content />
    </div>

    <!-- 記事フッター -->
    <footer class="mt-12 border-t border-border pt-6" data-pagefind-ignore>
      <div class="flex items-center justify-between">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground no-underline transition-colors hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          ホームに戻る
        </a>
      </div>
    </footer>
  </article>

  <!-- 見出しにアンカーリンクを付与 -->
  <script>
    function addHeadingAnchors() {
      const prose = document.querySelector(".prose");
      if (!prose) return;

      const headings = prose.querySelectorAll("h2, h3, h4");
      headings.forEach((heading) => {
        if (!heading.id) return;
        const anchor = document.createElement("a");
        anchor.href = `#${heading.id}`;
        anchor.className = "heading-anchor";
        anchor.setAttribute("aria-label", `セクション「${heading.textContent}」へのリンク`);
        heading.appendChild(anchor);
      });
    }

    addHeadingAnchors();
  </script>
</Base>
