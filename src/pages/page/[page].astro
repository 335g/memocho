---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { paginate, POSTS_PER_PAGE } from "../../utils/pagination";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const posts = import.meta.env.DEV
    ? allPosts
    : allPosts.filter((post) => !post.data.draft);

  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

  // ページ1は index.astro が担当 → ページ2以降のみ生成
  const paths = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({
      params: { page: String(i) },
      props: { page: i },
    });
  }
  return paths;
}

const isDev = import.meta.env.DEV;
const { page } = Astro.props;

const allPosts = await getCollection("posts");
const posts = isDev
  ? allPosts
  : allPosts.filter((post) => !post.data.draft);

posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const pageData = paginate(posts, page);
---

<Base
  title={`記事一覧 - ページ ${page}`}
  description={`memocho の記事一覧 ${page} ページ目`}
  path={`/page/${page}`}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-8 sm:py-12">
    <!-- ヘッダー -->
    <header class="mb-10">
      <div class="flex items-center gap-2">
        <a
          href="/"
          class="inline-flex items-center gap-1 text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          memocho
        </a>
      </div>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        記事一覧
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">
        ページ {page} / {pageData.totalPages}
      </p>
    </header>

    <!-- 記事グリッド -->
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        pageData.items.map((post) => (
          <li>
            <PostCard
              post={post}
              showDraftBadge={isDev && post.data.draft}
            />
          </li>
        ))
      }
    </ul>

    <!-- ページネーション -->
    <Pagination
      currentPage={pageData.currentPage}
      totalPages={pageData.totalPages}
      pageBasePath="/page"
    />
  </div>
</Base>
