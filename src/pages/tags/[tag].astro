---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getAllTags, getPostsByTag } from "../../utils/tags";
import { paginate } from "../../utils/pagination";
import { SITE } from "../../site.config";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const posts = import.meta.env.DEV
    ? allPosts
    : allPosts.filter((post) => !post.data.draft);

  const tags = getAllTags(posts);

  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

const isDev = import.meta.env.DEV;
const { tag } = Astro.props;

const allPosts = await getCollection("posts");
const posts = isDev
  ? allPosts
  : allPosts.filter((post) => !post.data.draft);

const filteredPosts = getPostsByTag(posts, tag);
const pageData = paginate(filteredPosts, 1);

// 構造化データ: BreadcrumbList（タグ詳細）
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "ホーム",
      item: SITE.url,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "タグ一覧",
      item: new URL("/tags", SITE.url).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `#${tag}`,
      item: new URL(`/tags/${tag}`, SITE.url).href,
    },
  ],
};
---

<Base
  title={`#${tag}`}
  description={`「${tag}」タグが付いた記事の一覧`}
  path={`/tags/${tag}`}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-8 sm:py-12">
    <!-- ヘッダー -->
    <header class="mb-10">
      <div class="flex items-center gap-2">
        <a
          href="/tags"
          class="inline-flex items-center gap-1 text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          タグ一覧
        </a>
      </div>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        #{tag}
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">
        「{tag}」タグの記事: {pageData.totalItems} 件
      </p>
    </header>

    <!-- 記事一覧 -->
    {
      pageData.items.length === 0 ? (
        <div class="flex flex-col items-center justify-center rounded-lg border border-dashed border-border py-16 text-center">
          <p class="text-lg font-medium text-muted-foreground">
            このタグの記事はありません
          </p>
        </div>
      ) : (
        <>
          <ul class="grid gap-6 sm:grid-cols-2">
            {
              pageData.items.map((post) => (
                <li>
                  <PostCard
                    post={post}
                    showDraftBadge={isDev && post.data.draft}
                  />
                </li>
              ))
            }
          </ul>

          <!-- ページネーション -->
          <Pagination
            currentPage={pageData.currentPage}
            totalPages={pageData.totalPages}
            pageBasePath={`/tags/${tag}/page`}
          />
        </>
      )
    }
  </div>
</Base>
