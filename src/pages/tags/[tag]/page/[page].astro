---
import { getCollection } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import PostCard from "../../../../components/PostCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import { getAllTags, getPostsByTag } from "../../../../utils/tags";
import { paginate, POSTS_PER_PAGE } from "../../../../utils/pagination";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const posts = import.meta.env.DEV
    ? allPosts
    : allPosts.filter((post) => !post.data.draft);

  const tags = getAllTags(posts);

  const paths: { params: { tag: string; page: string }; props: { tag: string; page: number } }[] = [];

  for (const { tag } of tags) {
    const taggedPosts = getPostsByTag(posts, tag);
    const totalPages = Math.ceil(taggedPosts.length / POSTS_PER_PAGE);

    // ページ1は [tag].astro が担当 → ページ2以降のみ生成
    for (let i = 2; i <= totalPages; i++) {
      paths.push({
        params: { tag, page: String(i) },
        props: { tag, page: i },
      });
    }
  }

  return paths;
}

const isDev = import.meta.env.DEV;
const { tag, page } = Astro.props;

const allPosts = await getCollection("posts");
const posts = isDev
  ? allPosts
  : allPosts.filter((post) => !post.data.draft);

const taggedPosts = getPostsByTag(posts, tag);
const pageData = paginate(taggedPosts, page);
---

<Base
  title={`#${tag} - ページ ${page}`}
  description={`「${tag}」タグの記事一覧 ${page} ページ目`}
  path={`/tags/${tag}/page/${page}`}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-8 sm:py-12">
    <!-- ヘッダー -->
    <header class="mb-10">
      <div class="flex items-center gap-2">
        <a
          href="/tags"
          class="inline-flex items-center gap-1 text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          タグ一覧
        </a>
      </div>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        #{tag}
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">
        「{tag}」タグの記事: {pageData.totalItems} 件（{page} / {pageData.totalPages} ページ）
      </p>
    </header>

    <!-- 記事グリッド -->
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        pageData.items.map((post) => (
          <li>
            <PostCard
              post={post}
              showDraftBadge={isDev && post.data.draft}
            />
          </li>
        ))
      }
    </ul>

    <!-- ページネーション -->
    <Pagination
      currentPage={pageData.currentPage}
      totalPages={pageData.totalPages}
      pageBasePath={`/tags/${tag}/page`}
    />
  </div>
</Base>
