---
export interface Props {
  currentPage: number;
  totalPages: number;
  /**
   * ページネーションのベースパス。
   * 例: "/page" → ページ1="/", ページ2="/page/2"
   * 例: "/tags/css/page" → ページ1="/tags/css", ページ2="/tags/css/page/2"
   */
  pageBasePath: string;
}

const { currentPage, totalPages, pageBasePath } = Astro.props;

/** ページ番号から URL を生成 */
function pageUrl(page: number): string {
  if (page <= 1) {
    return pageBasePath.replace(/\/page$/, "") || "/";
  }
  return `${pageBasePath}/${page}`;
}

const prevUrl = currentPage > 1 ? pageUrl(currentPage - 1) : null;
const nextUrl = currentPage < totalPages ? pageUrl(currentPage + 1) : null;

// 表示するページ番号のリスト（現在ページの前後2ページ + 端 + 省略記号）
function getPageNumbers(current: number, total: number): (number | "...")[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const pages: (number | "...")[] = [];

  // 常に 1 ページ目
  pages.push(1);

  if (current > 3) {
    pages.push("...");
  }

  // 現在ページの前後
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }

  if (current < total - 2) {
    pages.push("...");
  }

  // 常に最終ページ
  if (total > 1) {
    pages.push(total);
  }

  return pages;
}

const pageNumbers = getPageNumbers(currentPage, totalPages);
---

{
  totalPages > 1 && (
    <nav class="mt-12 flex flex-col items-center gap-4" aria-label="ページネーション">
      <!-- ページ情報 -->
      <p class="text-sm text-muted-foreground">
        {currentPage} / {totalPages} ページ
      </p>

      <!-- ページ番号 + 前後ボタン -->
      <div class="flex items-center gap-1">
        <!-- 前へ -->
        {
          prevUrl ? (
            <a
              href={prevUrl}
              class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-accent-foreground"
              aria-label="前のページ"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m15 18-6-6 6-6" />
              </svg>
            </a>
          ) : (
            <span
              class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground/40"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m15 18-6-6 6-6" />
              </svg>
            </span>
          )
        }

        <!-- ページ番号 -->
        {
          pageNumbers.map((num) =>
            num === "..." ? (
              <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-muted-foreground">
                …
              </span>
            ) : (
              <a
                href={pageUrl(num)}
                class:list={[
                  "inline-flex h-9 min-w-[2.25rem] items-center justify-center rounded-md px-1 text-sm font-medium no-underline transition-colors",
                  num === currentPage
                    ? "bg-primary text-primary-foreground"
                    : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
                ]}
                aria-label={`ページ ${num}`}
                aria-current={num === currentPage ? "page" : undefined}
              >
                {num}
              </a>
            ),
          )
        }

        <!-- 次へ -->
        {
          nextUrl ? (
            <a
              href={nextUrl}
              class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-accent-foreground"
              aria-label="次のページ"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
          ) : (
            <span
              class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground/40"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </span>
          )
        }
      </div>
    </nav>
  )
}
