---
import { SITE } from "../site.config";

export interface Props {
  /** フッター右側に表示する任意の通知テキスト */
  notice?: string;
}

const { notice } = Astro.props;
---

<footer class="border-t border-border bg-background">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 sm:px-6 py-3">
    <div class="flex items-center gap-3">
      <img
        src="/icon.png"
        alt="icon"
        width="28"
        height="28"
        class="rounded"
      />
      <p class="text-sm text-muted-foreground">
        {SITE.description}
      </p>
    </div>
    <div class="flex flex-col items-end gap-1">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} Yoshiki Kudo. All rights reserved.
      </p>
      {notice && (
        <p class="text-sm text-muted-foreground">
          {notice}
        </p>
      )}
    </div>
  </div>
</footer>
