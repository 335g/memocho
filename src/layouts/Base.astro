---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site.config";

export interface Props {
  title: string;
  description: string;
  /** ページの正規URL（絶対パス） */
  path?: string;
  /** OGP画像のURL（絶対URL） */
  ogImage?: string;
  /** OGP type (website / article) */
  ogType?: string;
  /** このページ独自の構造化データ（JSON-LD） */
  jsonLd?: Record<string, unknown>;
  /** フッター右側に表示する通知（開発モード表示など） */
  footerNotice?: string;
}

const {
  title,
  description,
  path = "/",
  ogImage,
  ogType = "website",
  jsonLd,
  footerNotice,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? SITE.url;
const pageUrl = new URL(path, siteUrl).href;
---

<!doctype html>
<html lang={SITE.lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- FOUC (Flash of Unstyled Content) 防止: ページ描画前にテーマを適用 -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- ファビコン -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- タイトル・説明・正規URL -->
    <title>{title} | {SITE.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <!-- OGP (Open Graph) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | ${SITE.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    {
      ogImage ? (
        <>
          <meta property="og:image" content={ogImage.startsWith("http") ? ogImage : new URL(ogImage, siteUrl).href} />
          <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
          <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
        </>
      ) : (
        <>
          <meta property="og:image" content={new URL("/og/default.png", siteUrl).href} />
          <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
          <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${SITE.name}`} />
    <meta name="twitter:description" content={description} />
    {
      ogImage ? (
        <meta name="twitter:image" content={ogImage.startsWith("http") ? ogImage : new URL(ogImage, siteUrl).href} />
      ) : (
        <meta name="twitter:image" content={new URL("/og/default.png", siteUrl).href} />
      )
    }

    <!-- 構造化データ (JSON-LD) -->
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <!-- OGP 拡張スロット（後続タスク用） -->
    <slot name="og" />
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <Header currentPath={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer notice={footerNotice} />
  </body>
</html>
